{
  "appId": "com.aplicaclimate.app",
  "appName": "AplicaClimate",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location"]
    }
  }
}
