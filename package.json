{
  "name": "aplicaclimate",
  "version": "0.3.0",
  "private": true,
  "description": "Mapa interactivo con clima detallado y recomendaciones de vestimenta (web, escritorio y móvil)",
  "author": "AplicaClimate",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/serve.js",
    "dev:lan": "node scripts/serve.js 8080 . 0.0.0.0",
    "preview": "node scripts/build-web.js && node scripts/serve.js 4174 dist",
    "test": "node scripts/test-server.js",
    "smoke": "node scripts/smoke-test.js",
    "build:web": "node scripts/build-web.js",
    "icons": "python scripts/make_icons.py",
    "desktop:install": "npm install --save-dev electron electron-builder",
    "desktop": "electron .",
    "desktop:build": "electron-builder --win --config electron-builder.json",
    "cap:install": "npm install --save-dev @capacitor/cli @capacitor/core @capacitor/android",
    "cap:add": "cap add android",
    "cap:sync": "npm run build:web && cap sync",
    "cap:open": "cap open android",
    "cap:run": "npm run build:web && cap run android"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
